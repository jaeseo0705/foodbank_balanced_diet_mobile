{
  "name": "foodbank-balanced-diet-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "export": "expo export --platform all",
    "test:web": "node scripts/check-web.mjs"
  },
  "dependencies": {
    "expo": "57.0.32",
    "expo-linear-gradient": "57.0.2",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "expo-image-picker": "57.0.21",
    "expo-build-properties": "57.0.23"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/react": "19.2.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "playwright": "1.62.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.jsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
